# GlassWiper 环境变量配置示例
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# 注意：.env 文件包含密钥，禁止提交到 Git

# 服务端口（容器/生产建议使用 8000；本地开发可用 3000）
PORT=8000

# 掌纹网关地址
PALM_HOST=open.palmoa.youtu.qq.com

# Bearer Token
# PALM_BEARER_TOKEN=你的BearerToken

# 掌纹注册用户ID（注册时服务端自动注入，不暴露在前端）
# PALM_USER_ID=你的UserId

# API Key（前端与后端之间的认证密钥，用 openssl rand -base64 32 生成）
# API_KEY=你的APIKey

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,https://open.palmoa.youtu.qq.com

# 速率限制（每分钟每IP最大请求数）
RATE_LIMIT_PER_MINUTE=30
